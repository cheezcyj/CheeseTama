# Ignore rules filter new paths; tracked history and file contents still need review.
# Unreviewed Markdown and Unity text sidecars remain local.
*.[mM][dD]
*.[mM][dD].meta
!/Assets/Environments/Milkroom/Props/OriginalModels/ORIGIN.md
!/Assets/Environments/Milkroom/Props/OriginalModels/ORIGIN.md.meta

# Only the confirmed public project roots are admitted.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/.github/
!/Assets/
!/Packages/
!/ProjectSettings/
!/Tools/
!/Deploy/
!/Docs/

# Admit the current runtime asset roots; new imports require a separate review.
/Assets/*
!/Assets/_Project/
!/Assets/_Project.meta
!/Assets/Characters/
!/Assets/Characters.meta
!/Assets/Environments/
!/Assets/Environments.meta
!/Assets/WebGLTemplates/
!/Assets/WebGLTemplates.meta
!/Assets/DefaultVolumeProfile.asset
!/Assets/DefaultVolumeProfile.asset.meta
!/Assets/UniversalRenderPipelineGlobalSettings.asset
!/Assets/UniversalRenderPipelineGlobalSettings.asset.meta

# Keep the public project focused on running and building the game.
# Regression tests, examples, authoring placeholders and their metadata stay local.
/Assets/_Project/*
!/Assets/_Project/link.xml
!/Assets/_Project/link.xml.meta
!/Assets/_Project/Art/
!/Assets/_Project/Art.meta
!/Assets/_Project/Plugins/
!/Assets/_Project/Plugins.meta
!/Assets/_Project/Resources/
!/Assets/_Project/Resources.meta
!/Assets/_Project/Scenes/
!/Assets/_Project/Scenes.meta
!/Assets/_Project/Scripts/
!/Assets/_Project/Scripts.meta
!/Assets/_Project/Shaders/
!/Assets/_Project/Shaders.meta
!/Assets/_Project/ThirdParty/
!/Assets/_Project/ThirdParty.meta
/Assets/_Project/Art/*
!/Assets/_Project/Art/GeneratedMaterials/
!/Assets/_Project/Art/GeneratedMaterials.meta

# Only the current shared Unity project settings are public.
# User-local package preferences and test-coverage output remain local.
/ProjectSettings/*
!/ProjectSettings/AudioManager.asset
!/ProjectSettings/ClusterInputManager.asset
!/ProjectSettings/DynamicsManager.asset
!/ProjectSettings/EditorBuildSettings.asset
!/ProjectSettings/EditorSettings.asset
!/ProjectSettings/GraphicsSettings.asset
!/ProjectSettings/InputManager.asset
!/ProjectSettings/MemorySettings.asset
!/ProjectSettings/MultiplayerManager.asset
!/ProjectSettings/NavMeshAreas.asset
!/ProjectSettings/PackageManagerSettings.asset
!/ProjectSettings/Physics2DSettings.asset
!/ProjectSettings/PresetManager.asset
!/ProjectSettings/ProjectSettings.asset
!/ProjectSettings/ProjectVersion.txt
!/ProjectSettings/QualitySettings.asset
!/ProjectSettings/SceneTemplateSettings.json
!/ProjectSettings/ShaderGraphSettings.asset
!/ProjectSettings/TagManager.asset
!/ProjectSettings/TimelineSettings.asset
!/ProjectSettings/TimeManager.asset
!/ProjectSettings/UnityConnectSettings.asset
!/ProjectSettings/VersionControlSettings.asset
!/ProjectSettings/VFXManager.asset

# Only the reviewed release workflow and its publishing tools are public.
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/webgl-release.yml
/Tools/*
!/Tools/WebGL/
/Tools/WebGL/*
!/Tools/WebGL/Validate-WebGlRelease.ps1
/Deploy/*
!/Deploy/WebGL/
/Deploy/WebGL/*
!/Deploy/WebGL/index.html
!/Deploy/WebGL/_headers
!/Deploy/WebGL/_redirects

# Package resolution is reproducible from these two manifests.
/Packages/*
!/Packages/manifest.json
!/Packages/packages-lock.json

# Public documentation and media are opt-in; internal records stay excluded.
/Docs/*
!/Docs/PROJECT_STRUCTURE.md
!/Docs/WebGL-Deployment.md
!/Docs/Media/
/Docs/Media/*
!/Docs/Media/cheesetama-character-reference.png
!/Docs/Media/cheesetama-demo-start.gif
!/Docs/Media/cheesetama-demo-care.gif
!/Docs/Media/cheesetama-demo-collection.gif
