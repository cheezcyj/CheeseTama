<linker>
  <!-- Local-account password hashing uses crypto factories whose concrete providers can be
       reached indirectly. Preserve them for IL2CPP/Web managed-code stripping. -->
  <assembly fullname="mscorlib" ignoreIfMissing="1">
    <namespace fullname="System.Security.Cryptography" preserve="all" />
  </assembly>
  <assembly fullname="System.Security.Cryptography.Algorithms" ignoreIfMissing="1">
    <namespace fullname="System.Security.Cryptography" preserve="all" />
  </assembly>
</linker>
