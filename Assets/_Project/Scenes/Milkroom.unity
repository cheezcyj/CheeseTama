    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b>\uBBF8\uB2C8\uAC8C\uC784 \uAE30\uB85D</b>\n\u2022 \uC6B0\uC720\uBC29\uC6B8
    \uBC1B\uAE30 \xB7 \uC544\uC9C1 \uD50C\uB808\uC774 \uAE30\uB85D\uC774 \uC5C6\uC5B4\uC694.\n\u2022
    \uCCAD\uC18C\uD558\uAE30 \xB7 \uC544\uC9C1 \uD50C\uB808\uC774 \uAE30\uB85D\uC774
    \uC5C6\uC5B4\uC694.\n\u2022 \uB9D0\uB791 \uC810\uD504 \xB7 \uC544\uC9C1 \uD50C\uB808\uC774
    \uAE30\uB85D\uC774 \uC5C6\uC5B4\uC694.\n\u2022 \uD30C\uB780 \uACF5 \uB180\uC774
    \xB7 \uC544\uC9C1 \uD50C\uB808\uC774 \uAE30\uB85D\uC774 \uC5C6\uC5B4\uC694.\n\n<b>\uCD5C\uADFC
    \uBBF8\uB2C8\uAC8C\uC784 \uACB0\uACFC</b>\n\uC544\uC9C1 \uC800\uC7A5\uB41C \uACB0\uACFC\uAC00
    \uC5C6\uC5B4\uC694.\n\n<b>\uC218\uBA74 \uC774\uB825</b>\n\uC544\uC9C1 \uC644\uB8CC\uD55C
    \uC218\uBA74 \uAE30\uB85D\uC774 \uC5C6\uC5B4\uC694.\n\n<b>\uBC1B\uC740 \uAE30\uB150\uD488</b>\n\uC544\uC9C1
    \uBC1B\uC740 \uAE30\uB150\uD488\uC774 \uC5C6\uC5B4\uC694."
