    0 (0\uC810)\r\n\uBC1C\uD6A8\uC6B0\uC720: \uB808\uBCA8 0 (0\uC810)\r\n\uCEE4\uD53C\uC6B0\uC720:
    \uB808\uBCA8 0 (0\uC810)\r\n\uBCC4\uBE5B \uC6B0\uC720: \uC7A0\uAE40\r\n\uD574\uAE08:
    \uBCC4\uBE5B \uC6B0\uC720 \uC7A0\uAE40\r\n\uB3CC\uBD04: 0\uD68C, \uC2DC\uAC04
    \uACBD\uACFC 0\uC2DC\uAC04\r\n\uC624\uB298: \uBA39\uAE30 0/3 \uC694\uB9AC 0/2
    \uB180\uC774 0/3 \uCCAD\uC18C 0/2 \uD734\uC2DD 0/2, \uC644\uB8CC 0\r\n\uC138\uC158:
